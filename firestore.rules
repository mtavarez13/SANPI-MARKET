rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isRegisteredUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isGuest() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function validGuestDelivery(deliveryId) {
      return isGuest()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.id == deliveryId
        && request.resource.data.trackingNumber == deliveryId
        && request.resource.data.isMarketplaceOrder == true
        && request.resource.data.status in ['pendiente', 'pendiente de recoger pickup']
        && request.resource.data.quantity is number && request.resource.data.quantity > 0
        && request.resource.data.basePrice is number && request.resource.data.basePrice >= 0
        && request.resource.data.deliveryFee is number && request.resource.data.deliveryFee >= 0
        && request.resource.data.deliveryPayment == 0
        && request.resource.data.isPaidToOffice == false
        && request.resource.data.totalToCollect is number
        && (request.resource.data.paymentMethod in ['COD', 'contra entrega']
          ? request.resource.data.totalToCollect == request.resource.data.basePrice + request.resource.data.deliveryFee
          : request.resource.data.totalToCollect == 0);
    }

    function validGuestTransaction(transactionId) {
      return isGuest()
        && request.resource.data.id == transactionId
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.isMarketplaceOrder == true
        && request.resource.data.status == 'pendiente'
        && request.resource.data.quantity is number && request.resource.data.quantity > 0
        && request.resource.data.basePrice is number && request.resource.data.basePrice >= 0
        && request.resource.data.shippingFee is number && request.resource.data.shippingFee >= 0
        && request.resource.data.total == request.resource.data.basePrice + request.resource.data.shippingFee
        && request.resource.data.trackingNumber is string;
    }

    function isSuperAdmin() {
      return isRegisteredUser() && (
        request.auth.token.email == 'martin.tavarez.gomez@gmail.com' ||
        request.auth.token.email == 'sanpimarkeplace@gmail.com' ||
        request.auth.token.email == 'sanpimarketplace@gmail.com' ||
        request.auth.uid == 'jl3RcRbikZWCdw08NLf8kWLOcJB3'
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isRegisteredUser() && (
          (exists(/databases/$(database)/documents/user_role_assignments/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/user_role_assignments/$(request.auth.uid)).data.role == 'admin') ||
          (request.auth.token.email != null &&
           exists(/databases/$(database)/documents/user_role_assignments/$(request.auth.token.email)) &&
           get(/databases/$(database)/documents/user_role_assignments/$(request.auth.token.email)).data.role == 'admin')
        )
      );
    }

    function isFulfillment() {
      return isRegisteredUser() && (
        request.auth.token.get('role', '') == 'fulfillment' ||
        (exists(/databases/$(database)/documents/user_role_assignments/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/user_role_assignments/$(request.auth.uid)).data.role == 'fulfillment')
      );
    }

    function isOwner(userId) {
      return isRegisteredUser() && (
        request.auth.uid == userId ||
        (request.auth.token.email != null && request.auth.token.email == userId)
      );
    }

    // Stores: Public catalog reading, partner/admin updates
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isRegisteredUser();
      allow update, delete: if isAdmin() || (isRegisteredUser() && (resource.data.ownerEmail == request.auth.token.email || resource.data.ownerId == request.auth.uid));
    }

    // Articles / Products: Public reading, partner/admin creation and edits
    match /articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if isRegisteredUser();
    }

    // Deliveries & Logistics
    match /deliveries/{deliveryId} {
      allow get: if true;
      allow list: if isRegisteredUser();
      allow create: if isRegisteredUser() || validGuestDelivery(deliveryId);
      allow update: if isRegisteredUser() || (isGuest()
        && resource.data.createdByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'sachaPackResponse', 'sachaPackStatus', 'sachaPackDispatchedAt'
        ]));
      allow delete: if isAdmin() || isFulfillment();
    }

    // Transactions / Ledger
    match /transactions/{transactionId} {
      allow read: if isRegisteredUser();
      allow create: if isRegisteredUser() || validGuestTransaction(transactionId);
      allow update, delete: if isRegisteredUser();
    }

    // Subscriptions for partner stores
    match /marketplace_subscriptions/{subId} {
      allow read, create: if isRegisteredUser();
      allow update, delete: if isAdmin();
    }

    // Operational Expenses: Admins only
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isRegisteredUser();
      allow write: if isAdmin() || isOwner(userId);
    }

    match /marketplace_users/{userId} {
      allow read: if isRegisteredUser();
      allow write: if isAdmin() || isOwner(userId);
    }

    // Persistent Role Assignments: Read by user/admin, managed by admins
    match /user_role_assignments/{assignmentId} {
      allow read: if isRegisteredUser();
      allow write: if isAdmin();
    }

    // Webhook signing keys are accessible only through the App Hosting server.
    match /carrier_webhook_credentials/{providerId} {
      allow read, write: if false;
    }

    // Catch-all for authenticated operations across other app modules
    match /{legacyCollection}/{legacyDoc} {
      allow read, write: if isRegisteredUser()
        && legacyCollection != 'stores'
        && legacyCollection != 'articles'
        && legacyCollection != 'deliveries'
        && legacyCollection != 'transactions'
        && legacyCollection != 'carrier_webhook_credentials'
        && legacyCollection != 'marketplace_subscriptions'
        && legacyCollection != 'expenses'
        && legacyCollection != 'users'
        && legacyCollection != 'marketplace_users'
        && legacyCollection != 'user_role_assignments';
    }
  }
}

